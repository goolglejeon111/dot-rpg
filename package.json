{
  "name": "dot-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "art": "node tools/pixel-art/build.mjs && node tools/pixel-art/gen-hd.mjs",
    "art:battle": "node tools/pixel-art/gen-battle.mjs && node tools/pixel-art/build.mjs && node tools/pixel-art/gen-hd.mjs",
    "art:palace": "node tools/pixel-art/gen-palace.mjs && node tools/pixel-art/build.mjs && node tools/pixel-art/gen-hd.mjs",
    "map": "node tools/map/make-village.mjs",
    "maps": "node tools/maps/gen-maps.mjs",
    "script": "node tools/script/convert.mjs",
    "script:check": "node tools/script/check.mjs",
    "art:hd": "node tools/pixel-art/gen-hd.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
